# Copy to .env.local (or .env) for local token scripts only. Never commit real keys.
# .env.local must NEVER be committed.
# Used by: npm run hedera:create-token

HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=0.0.xxxxxx
HEDERA_OPERATOR_KEY=replace_with_testnet_private_key
ZC_TOKEN_NAME=ZeroCollab Token
ZC_TOKEN_SYMBOL=ZC
ZC_INITIAL_SUPPLY=100000
