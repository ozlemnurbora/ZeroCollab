@prefix zce: <http://zerocollab.dev/ontology/evaluation#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# ─────────────────────────────────────────────
# Ontology Header
# ─────────────────────────────────────────────

<http://zerocollab.dev/ontology/evaluation> a owl:Ontology ;
    rdfs:label "ZeroCollab Evaluation Ontology"@en ;
    dcterms:title "ZeroCollab Project Evaluation Ontology"@en ;
    dcterms:description """This ontology defines the methodology and rules for AI-assisted 
    project evaluation. The AI reads this ontology and the uploaded project files together, 
    then autonomously determines which quality dimensions are relevant and evaluates the 
    project out of 100 points. No criteria are hardcoded — the AI decides based on what 
    it finds in the project."""@en ;
    dcterms:creator "ZeroCollab Team — Özlem Nur Bora, Songül Nur Öztürk, Nisanur Karataş"@en ;
    dcterms:created "2026-04-05"^^xsd:date ;
    dcterms:modified "2026-04-11"^^xsd:date ;
    owl:versionInfo "3.0.0" .

# ─────────────────────────────────────────────
# Core Evaluation Classes
# ─────────────────────────────────────────────

zce:EvaluationSession a owl:Class ;
    rdfs:label "Evaluation Session"@en ;
    skos:definition """A single evaluation run where the AI analyzes uploaded project files, 
    determines applicable quality dimensions autonomously, assigns scores, and produces 
    structured feedback. Total score is always normalized to 100 points."""@en .

zce:QualityDimension a owl:Class ;
    rdfs:label "Quality Dimension"@en ;
    skos:definition """An abstract quality aspect that MAY be relevant to a software project. 
    The AI reads all defined dimensions and decides which ones apply to the uploaded project. 
    Only applicable dimensions are included in scoring. Scores are weighted equally across 
    all applicable dimensions to always sum to 100."""@en .

zce:EvaluationMethodology a owl:Class ;
    rdfs:label "Evaluation Methodology"@en ;
    skos:definition """The set of rules and principles the AI must follow when evaluating 
    a project. Defines how to detect applicable dimensions, how to score, and how to 
    generate feedback."""@en .

zce:ScoringRule a owl:Class ;
    rdfs:label "Scoring Rule"@en ;
    skos:definition """A rule that governs how raw dimension scores are computed and 
    normalized to produce a final score out of 100."""@en .

zce:SubmissionScope a owl:Class ;
    rdfs:label "Submission Scope"@en ;
    skos:definition """Describes what kind of artifact the user uploaded for evaluation.
    The AI uses the submission scope to decide which QualityDimensions are applicable,
    which file types to prioritize, and how to weight the final assessment. If no scope
    is selected by the user, the AI infers one from a quick scan of file names and
    folder structure, then confirms with the user before proceeding."""@en .

zce:scopeKey a owl:DatatypeProperty ;
    rdfs:label "scope key"@en ;
    rdfs:domain zce:SubmissionScope ;
    rdfs:range xsd:string ;
    skos:definition "Stable machine-readable identifier for a SubmissionScope (e.g. 'full_project', 'testing_only'). Used by the frontend to map ontology instances to UI options."@en .

zce:scopeFocus a owl:DatatypeProperty ;
    rdfs:label "scope focus"@en ;
    rdfs:domain zce:SubmissionScope ;
    rdfs:range xsd:string ;
    skos:definition "Short instruction the AI prepends to its evaluation when this scope is selected. Tells the AI what to focus on."@en .

zce:scopeFilePatterns a owl:DatatypeProperty ;
    rdfs:label "scope file patterns"@en ;
    rdfs:domain zce:SubmissionScope ;
    rdfs:range xsd:string ;
    skos:definition "Comma-separated list of file glob patterns the file prioritizer should rank highest for this scope."@en .

zce:scopeOrder a owl:DatatypeProperty ;
    rdfs:label "scope display order"@en ;
    rdfs:domain zce:SubmissionScope ;
    rdfs:range xsd:integer ;
    skos:definition "Order in which scopes appear in the UI dropdown."@en .

# ─────────────────────────────────────────────
# Evaluation Methodology Instance
# ─────────────────────────────────────────────

zce:ZeroCollabMethodology a zce:EvaluationMethodology ;
    rdfs:label "ZeroCollab AI Evaluation Methodology"@en ;
    skos:definition """The AI evaluation methodology for ZeroCollab."""@en ;

    zce:step1 """STEP 1 — READ PROJECT: Carefully read all uploaded project files. 
    Identify the technologies, architecture patterns, frameworks, and features present."""@en ;

    zce:step2 """STEP 2 — DETERMINE DIMENSIONS: From the QualityDimension catalog defined 
    in this ontology, select ONLY the dimensions that are genuinely applicable to this project. 
    A dimension is applicable if the project actually implements or attempts to implement 
    that aspect. Do NOT include dimensions for features the project does not have."""@en ;

    zce:step3 """STEP 3 — SCORE EACH DIMENSION: For each applicable dimension, assign a 
    raw score from 1 to 10 based on the scoring guidelines defined in that dimension."""@en ;

    zce:step4 """STEP 4 — NORMALIZE TO 100: Compute the final score as: 
    (sum of raw scores / (number of applicable dimensions * 10)) * 100. 
    This ensures the total is always out of 100 regardless of how many dimensions apply."""@en ;

    zce:step5 """STEP 5 — GENERATE FEEDBACK: For each applicable dimension, write 2-3 
    sentences of specific, evidence-based feedback referencing actual code or files. 
    Include one concrete improvement suggestion per dimension."""@en ;

    zce:step6 """STEP 6 — OVERALL SUMMARY: Write a 3-4 sentence overall assessment 
    summarizing strengths, weaknesses, and the most important improvement area."""@en .

# ─────────────────────────────────────────────
# Quality Dimension Catalog
# ─────────────────────────────────────────────

zce:dimensionWeight a owl:DatatypeProperty ;
    rdfs:label "dimension weight"@en ;
    rdfs:domain zce:QualityDimension ;
    rdfs:range xsd:decimal ;
    skos:definition """Relative importance of this dimension. Used for weighted scoring: 
    final score = sum(rawScore_i * weight_i) / sum(weight_i) * 10, then normalized to 100. 
    Higher weight = more impact on final score."""@en .

zce:CodeQualityDimension a zce:QualityDimension ;
    rdfs:label "Code Quality"@en ;
    zce:dimensionKey "code_quality" ;
    zce:dimensionWeight "1.5"^^xsd:decimal ;
    zce:applicabilityCondition """Applicable to ANY software project that contains source code."""@en ;
    zce:scoringGuideline """Score 1-3: Poor structure, no conventions, many code smells. 
    Score 4-6: Adequate structure, some issues present. 
    Score 7-8: Good modularity, clear naming, minor issues. 
    Score 9-10: Excellent readability, clean architecture, best practices followed."""@en .

zce:DocumentationDimension a zce:QualityDimension ;
    rdfs:label "Documentation"@en ;
    zce:dimensionKey "documentation" ;
    zce:dimensionWeight "1.0"^^xsd:decimal ;
    zce:applicabilityCondition """Applicable to ANY software project."""@en ;
    zce:scoringGuideline """Score 1-3: No documentation or README. 
    Score 4-6: Basic README, minimal comments. 
    Score 7-8: Good README, code comments, setup instructions. 
    Score 9-10: Comprehensive docs, API references, architecture explained."""@en .

zce:FunctionalityDimension a zce:QualityDimension ;
    rdfs:label "Functionality"@en ;
    zce:dimensionKey "functionality" ;
    zce:dimensionWeight "2.0"^^xsd:decimal ;
    zce:applicabilityCondition """Applicable to ANY software project."""@en ;
    zce:scoringGuideline """Score 1-3: Core features missing or broken. 
    Score 4-6: Core features work, edge cases fail. 
    Score 7-8: All features work, minor issues. 
    Score 9-10: All features work correctly with good error handling."""@en .

zce:UIUXDimension a zce:QualityDimension ;
    rdfs:label "UI/UX Design"@en ;
    zce:dimensionKey "uiux_design" ;
    zce:dimensionWeight "1.0"^^xsd:decimal ;
    zce:applicabilityCondition """Applicable to projects with a user interface (web, mobile, desktop apps)."""@en ;
    zce:scoringGuideline """Score 1-3: Poor or unusable interface. 
    Score 4-6: Functional but poor aesthetics or UX. 
    Score 7-8: Clean design, good usability. 
    Score 9-10: Excellent design, accessibility, responsive, consistent."""@en .

zce:P2PDimension a zce:QualityDimension ;
    rdfs:label "P2P / Real-time Communication"@en ;
    zce:dimensionKey "p2p_implementation" ;
    zce:dimensionWeight "2.0"^^xsd:decimal ;
    zce:applicabilityCondition """Applicable ONLY if the project implements peer-to-peer 
    communication, WebRTC, PeerJS, WebSockets for real-time sync, or similar technologies."""@en ;
    zce:scoringGuideline """Score 1-3: P2P attempted but unreliable or broken. 
    Score 4-6: Basic P2P works in ideal conditions. 
    Score 7-8: Stable connections, handles reconnection. 
    Score 9-10: Robust P2P with TURN, multi-peer, offline handling."""@en .

zce:PWADimension a zce:QualityDimension ;
    rdfs:label "PWA / Offline Capabilities"@en ;
    zce:dimensionKey "pwa_compliance" ;
    zce:dimensionWeight "1.0"^^xsd:decimal ;
    zce:applicabilityCondition """Applicable ONLY if the project is a Progressive Web App 
    with service workers, offline support, or installability."""@en ;
    zce:scoringGuideline """Score 1-3: PWA attempted but non-functional offline. 
    Score 4-6: Basic service worker, partial offline. 
    Score 7-8: Good offline support, installable. 
    Score 9-10: Full PWA compliance, fast loading, complete offline functionality."""@en .

zce:OntologyDimension a zce:QualityDimension ;
    rdfs:label "Ontology / Semantic Web"@en ;
    zce:dimensionKey "ontology_quality" ;
    zce:dimensionWeight "2.0"^^xsd:decimal ;
    zce:applicabilityCondition """Applicable ONLY if the project uses OWL ontologies, 
    RDF, SPARQL, SHACL, or semantic web technologies."""@en ;
    zce:scoringGuideline """Score 1-3: Ontology exists but poorly structured. 
    Score 4-6: Basic ontology with some annotations. 
    Score 7-8: Well-structured ontology, good coverage. 
    Score 9-10: Excellent ontology design, complete annotations, SHACL validation."""@en .

zce:MLDimension a zce:QualityDimension ;
    rdfs:label "AI / Machine Learning Integration"@en ;
    zce:dimensionKey "ml_integration" ;
    zce:dimensionWeight "1.5"^^xsd:decimal ;
    zce:applicabilityCondition """Applicable ONLY if the project integrates AI/ML models, 
    LLMs, neural networks, or machine learning APIs."""@en ;
    zce:scoringGuideline """Score 1-3: AI integrated but produces poor results. 
    Score 4-6: Basic AI integration, works partially. 
    Score 7-8: Good AI integration, meaningful results. 
    Score 9-10: Excellent AI usage, well-prompted, handles errors gracefully."""@en .

zce:BlockchainDimension a zce:QualityDimension ;
    rdfs:label "Blockchain / Distributed Ledger"@en ;
    zce:dimensionKey "blockchain_integration" ;
    zce:dimensionWeight "2.0"^^xsd:decimal ;
    zce:applicabilityCondition """Applicable ONLY if the project uses blockchain, 
    smart contracts, token economics, or distributed ledger technologies."""@en ;
    zce:scoringGuideline """Score 1-3: Blockchain attempted but non-functional. 
    Score 4-6: Basic on-chain operations work. 
    Score 7-8: Solid blockchain integration, testnet deployed. 
    Score 9-10: Production-ready, secure, well-designed token economics."""@en .

zce:TestingDimension a zce:QualityDimension ;
    rdfs:label "Testing Coverage"@en ;
    zce:dimensionKey "testing_coverage" ;
    zce:dimensionWeight "1.5"^^xsd:decimal ;
    zce:applicabilityCondition """Applicable ONLY if the project contains test files 
    (unit, integration, or end-to-end tests)."""@en ;
    zce:scoringGuideline """Score 1-3: Minimal tests, most code untested. 
    Score 4-6: Some tests, basic coverage. 
    Score 7-8: Good coverage, meaningful test cases. 
    Score 9-10: Comprehensive test suite, high coverage, all layers tested."""@en .

zce:SecurityDimension a zce:QualityDimension ;
    rdfs:label "Security"@en ;
    zce:dimensionKey "security" ;
    zce:dimensionWeight "1.5"^^xsd:decimal ;
    zce:applicabilityCondition """Applicable if the project handles user data, 
    authentication, authorization, or sensitive information."""@en ;
    zce:scoringGuideline """Score 1-3: Obvious security issues present. 
    Score 4-6: Basic security measures, some gaps. 
    Score 7-8: Good security practices, minor concerns. 
    Score 9-10: Strong security, proper auth, data protection, no sensitive data exposed."""@en .

zce:PerformanceDimension a zce:QualityDimension ;
    rdfs:label "Performance"@en ;
    zce:dimensionKey "performance" ;
    zce:dimensionWeight "1.0"^^xsd:decimal ;
    zce:applicabilityCondition """Applicable if the project has measurable performance 
    requirements or handles significant data/computation."""@en ;
    zce:scoringGuideline """Score 1-3: Noticeably slow or resource-heavy. 
    Score 4-6: Acceptable performance with some inefficiencies. 
    Score 7-8: Good performance, minor optimizations possible. 
    Score 9-10: Excellent performance, optimized queries, lazy loading, caching."""@en .

# ─────────────────────────────────────────────
# AI Response Format Rules
# ─────────────────────────────────────────────

zce:ResponseFormatRule a zce:ScoringRule ;
    rdfs:label "AI Response Format"@en ;
    zce:formatInstruction """The AI MUST respond in this exact JSON format with no markdown:
{
  "detectedDimensions": ["dimension_key_1", "dimension_key_2"],
  "criteria": {
    "dimension_key": {
      "label": "Human readable label",
      "rawScore": 7,
      "maxRawScore": 10,
      "weight": 1.5,
      "feedback": "Specific evidence-based feedback referencing actual code."
    }
  },
  "normalizedTotal": 72,
  "overallFeedback": "3-4 sentence overall assessment."
}
WEIGHTED SCORING FORMULA (mandatory):
- Each dimension has a weight defined in the ontology (zce:dimensionWeight)
- weightedScore_i = rawScore_i * weight_i
- normalizedTotal = (sum of weightedScore_i / (sum of weight_i * 10)) * 100, rounded to integer
- Always include the weight value in each criterion's JSON object
- Example: if code_quality (weight=1.5) scores 7, functionality (weight=2.0) scores 8:
  weightedTotal = (7*1.5 + 8*2.0) / ((1.5+2.0)*10) * 100 = (10.5+16)/(35) * 100 = 75.7 → 76"""@en .

# ─────────────────────────────────────────────
# Grade Thresholds
# ─────────────────────────────────────────────

zce:GradeThreshold a owl:Class ;
    rdfs:label "Grade Threshold"@en ;
    skos:definition "Defines the minimum percentage for each letter grade."@en .

zce:gradeLabel a owl:DatatypeProperty ;
    rdfs:label "grade label"@en ;
    rdfs:range xsd:string .

zce:gradeName a owl:DatatypeProperty ;
    rdfs:label "grade name"@en ;
    rdfs:range xsd:string .

zce:minPercentage a owl:DatatypeProperty ;
    rdfs:label "min percentage"@en ;
    rdfs:range xsd:integer .

zce:GradeA a zce:GradeThreshold ;
    rdfs:label "Grade A"@en ;
    zce:gradeLabel "A" ;
    zce:gradeName "Excellent" ;
    zce:minPercentage "90"^^xsd:integer .

zce:GradeAMinus a zce:GradeThreshold ;
    rdfs:label "Grade A-"@en ;
    zce:gradeLabel "A-" ;
    zce:gradeName "Excellent" ;
    zce:minPercentage "85"^^xsd:integer .

zce:GradeBPlus a zce:GradeThreshold ;
    rdfs:label "Grade B+"@en ;
    zce:gradeLabel "B+" ;
    zce:gradeName "Strong" ;
    zce:minPercentage "80"^^xsd:integer .

zce:GradeB a zce:GradeThreshold ;
    rdfs:label "Grade B"@en ;
    zce:gradeLabel "B" ;
    zce:gradeName "Strong" ;
    zce:minPercentage "75"^^xsd:integer .

zce:GradeBMinus a zce:GradeThreshold ;
    rdfs:label "Grade B-"@en ;
    zce:gradeLabel "B-" ;
    zce:gradeName "Strong" ;
    zce:minPercentage "70"^^xsd:integer .

zce:GradeCPlus a zce:GradeThreshold ;
    rdfs:label "Grade C+"@en ;
    zce:gradeLabel "C+" ;
    zce:gradeName "Satisfactory" ;
    zce:minPercentage "65"^^xsd:integer .

zce:GradeC a zce:GradeThreshold ;
    rdfs:label "Grade C"@en ;
    zce:gradeLabel "C" ;
    zce:gradeName "Satisfactory" ;
    zce:minPercentage "60"^^xsd:integer .

zce:GradeCMinus a zce:GradeThreshold ;
    rdfs:label "Grade C-"@en ;
    zce:gradeLabel "C-" ;
    zce:gradeName "Satisfactory" ;
    zce:minPercentage "55"^^xsd:integer .

zce:GradeDPlus a zce:GradeThreshold ;
    rdfs:label "Grade D+"@en ;
    zce:gradeLabel "D+" ;
    zce:gradeName "Needs Improvement" ;
    zce:minPercentage "50"^^xsd:integer .

zce:GradeD a zce:GradeThreshold ;
    rdfs:label "Grade D"@en ;
    zce:gradeLabel "D" ;
    zce:gradeName "Needs Improvement" ;
    zce:minPercentage "45"^^xsd:integer .

zce:GradeDMinus a zce:GradeThreshold ;
    rdfs:label "Grade D-"@en ;
    zce:gradeLabel "D-" ;
    zce:gradeName "Needs Improvement" ;
    zce:minPercentage "40"^^xsd:integer .

zce:GradeF a zce:GradeThreshold ;
    rdfs:label "Grade F"@en ;
    zce:gradeLabel "F" ;
    zce:gradeName "Insufficient" ;
    zce:minPercentage "0"^^xsd:integer .

# ─────────────────────────────────────────────
# Submission Scope Instances
# ─────────────────────────────────────────────

zce:FullProjectScope a zce:SubmissionScope ;
    rdfs:label "Full project"@en ;
    zce:scopeKey "full_project" ;
    zce:scopeOrder 1 ;
    zce:scopeFocus """The user uploaded the complete project. Evaluate ALL applicable
    quality dimensions in the ontology. Detect technologies and select dimensions
    accordingly. This is the default, broadest evaluation mode.""" ;
    zce:scopeFilePatterns "src/**, public/**, *.md, *.json, *.ttl, package.json, README*, __tests__/**, *.test.js, *.test.jsx, *.test.ts, *.test.tsx, *.spec.js, *.spec.jsx, supabase/**, scripts/**" ;
    skos:definition "Complete project submission — evaluate everything that is present."@en .

zce:DesignOnlyScope a zce:SubmissionScope ;
    rdfs:label "Design only"@en ;
    zce:scopeKey "design_only" ;
    zce:scopeOrder 2 ;
    zce:scopeFocus """The user uploaded UI/UX design artifacts — components, styles,
    wireframes, design tokens, or HTML/CSS. Focus on UIUXDimension, Code Quality
    (component structure), and accessibility. Skip dimensions tied to backend,
    networking, blockchain, or testing unless evidence is present.""" ;
    zce:scopeFilePatterns "*.css, *.scss, *.jsx, *.tsx, *.html, *.svg, *.figma, *.sketch, components/**, styles/**, design/**, ui/**" ;
    skos:definition "Design-focused submission — UI components, styles, visual artifacts."@en .

zce:TestingOnlyScope a zce:SubmissionScope ;
    rdfs:label "Testing only"@en ;
    zce:scopeKey "testing_only" ;
    zce:scopeOrder 3 ;
    zce:scopeFocus """The user uploaded test code or test artifacts. Focus on
    TestingDimension as primary. Examine test coverage breadth, assertion quality,
    mocking strategy, and test organization. Do NOT score dimensions like UI/UX
    or Blockchain unless test files themselves cover those concerns.""" ;
    zce:scopeFilePatterns "*.test.*, *.spec.*, __tests__/**, tests/**, test/**, e2e/**, cypress/**, jest.config.*, vitest.config.*, playwright.config.*" ;
    skos:definition "Testing submission — unit, integration, or e2e tests."@en .

zce:DocumentationOnlyScope a zce:SubmissionScope ;
    rdfs:label "Documentation only"@en ;
    zce:scopeKey "documentation_only" ;
    zce:scopeOrder 4 ;
    zce:scopeFocus """The user uploaded documentation — README, project proposal,
    conference paper, technical report, or design document. Focus on DocumentationDimension
    as primary. Evaluate clarity, completeness, technical accuracy, citations,
    structure, and the alignment of stated goals with the described approach.
    Skip code-quality dimensions entirely.""" ;
    zce:scopeFilePatterns "*.md, *.pdf, *.docx, *.txt, *.tex, docs/**, doc/**, README*, CHANGELOG*, paper/**" ;
    skos:definition "Documentation submission — text deliverables, no executable code expected."@en .

zce:AnalysisOnlyScope a zce:SubmissionScope ;
    rdfs:label "Analysis only"@en ;
    zce:scopeKey "analysis_only" ;
    zce:scopeOrder 5 ;
    zce:scopeFocus """The user uploaded analysis artifacts — requirements analysis,
    use cases, UML diagrams, domain model, ontology, or system specification.
    Focus on completeness of stakeholder coverage, clarity of requirements, and
    soundness of modelling. If ontology files are present, score OntologyDimension.
    Skip implementation-quality dimensions.""" ;
    zce:scopeFilePatterns "*.uml, *.ttl, *.owl, *.rdf, *.bpmn, analysis/**, requirements/**, models/**, *.puml, *.drawio" ;
    skos:definition "Analysis submission — requirements, models, ontologies, diagrams."@en .

zce:ArchitectureOnlyScope a zce:SubmissionScope ;
    rdfs:label "Architecture only"@en ;
    zce:scopeKey "architecture_only" ;
    zce:scopeOrder 6 ;
    zce:scopeFocus """The user uploaded architecture artifacts — module diagrams,
    component diagrams, deployment views, ADRs, or high-level design documents.
    Focus on separation of concerns, modularity, scalability considerations, and
    the rationale behind structural choices. Skip dimensions tied to a single
    feature implementation.""" ;
    zce:scopeFilePatterns "architecture/**, adr/**, ADR-*.md, docs/architecture/**, *.drawio, diagrams/**, design-docs/**" ;
    skos:definition "Architecture submission — structural design and rationale."@en .

zce:SecurityAuditScope a zce:SubmissionScope ;
    rdfs:label "Security audit"@en ;
    zce:scopeKey "security_audit" ;
    zce:scopeOrder 7 ;
    zce:scopeFocus """The user uploaded code or artifacts for a security review.
    Focus on SecurityDimension as primary. Examine authentication flows, input
    validation, secrets handling, encryption usage, dependency risks, and exposed
    endpoints. Score Performance and Code Quality only when they intersect with
    security concerns.""" ;
    zce:scopeFilePatterns "auth/**, security/**, middleware/**, *.env*, *.pem, *.key, supabase/migrations/**, *config*, package-lock.json" ;
    skos:definition "Security-focused submission — auditing code for vulnerabilities."@en .

zce:PerformanceAuditScope a zce:SubmissionScope ;
    rdfs:label "Performance audit"@en ;
    zce:scopeKey "performance_audit" ;
    zce:scopeOrder 8 ;
    zce:scopeFocus """The user uploaded code or profiling artifacts for a performance
    review. Focus on PerformanceDimension as primary. Examine algorithmic complexity,
    memoization, lazy loading, network round trips, bundle size, render performance,
    and database query efficiency. Score other dimensions only when they directly
    affect performance.""" ;
    zce:scopeFilePatterns "*.perf, lighthouse-*.json, vite.config.*, webpack.config.*, hooks/**, utils/**, *.bench.*, benchmarks/**" ;
    skos:definition "Performance-focused submission — auditing code for speed and efficiency."@en .
